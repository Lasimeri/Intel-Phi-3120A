@@ -1,4 +1,7 @@
-//===-- X86Subtarget.h - Define Subtarget for the X86 ----------*- C++ -*--===//
+  // Intel Phi 3120A project (knc64-x87): Knights Corner is a 64-bit core
+  // without CMOV, so 64-bit mode must not imply it. The -cmov feature is
+  // honored; SSE1 still implies CMOV because every SSE-capable core has it.
+  bool canUseCMOV() const { return hasCMOV() || hasSSE1(); }//===-- X86Subtarget.h - Define Subtarget for the X86 ----------*- C++ -*--===//
