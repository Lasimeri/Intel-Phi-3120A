{
  "arch": "x86_64",
  "cpu": "x86-64",
  "crt-objects-fallback": "musl",
  "crt-static-default": true,
  "crt-static-respected": true,
  "data-layout": "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "dynamic-linking": true,
  "env": "musl",
  "features": "-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-sse4a,-avx,-avx2,-fma,-f16c,-cmov,-nopl,-movbe,-popcnt,-lzcnt,-bmi,-bmi2,-xsave,-cx16,-prfchw,-clflushopt,-rdrnd,-rdseed,-adx,-fsgsbase,-pclmul,-aes,-sha,+x87",
  "has-rpath": true,
  "linker-flavor": "gnu-cc",
  "llvm-target": "x86_64-unknown-linux-musl",
  "max-atomic-width": 64,
  "os": "linux",
  "panic-strategy": "abort",
  "plt-by-default": false,
  "position-independent-executables": true,
  "relro-level": "full",
  "stack-probes": {
    "kind": "inline"
  },
  "static-position-independent-executables": true,
  "supported-sanitizers": [],
  "supported-split-debuginfo": [
    "packed",
    "unpacked",
    "off"
  ],
  "target-family": [
    "unix"
  ],
  "target-pointer-width": "64",
  "vendor": "knc"
}
