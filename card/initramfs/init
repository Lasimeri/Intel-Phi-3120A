#!/bin/sh
# init: first process on the card. Mounts the pseudo filesystems, brings up
# the ring network device, starts the SSH server when the image has one,
# reports what it runs on, and supervises an interactive shell on the
# console. PID 1 stays this script: busybox's poweroff/halt/reboot signal
# PID 1 (SIGUSR2/SIGUSR1/SIGTERM), the trap turns that into the kernel's
# power off (the KNC platform layer writes POST "KH" and halts), and a shell
# that exits is replaced instead of taking init down with it. See build.md.
/bin/busybox mkdir -p /proc /sys /dev /tmp
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox mkdir -p /dev/pts
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null
/bin/busybox hostname phi
# Persistent storage: /dev/phiblk0 is a disk image on the host served over
# the ring (kernel patch 0025, phictl boot --disk). It appears once the host
# answers the driver's identify request, shortly after init starts.
disk="no disk"
i=0
while [ $i -lt 5 ] && [ ! -b /dev/phiblk0 ]; do /bin/busybox sleep 1; i=$((i+1)); done
if [ -b /dev/phiblk0 ]; then
	/bin/busybox mkdir -p /data
	if /bin/busybox mount -t ext4 -o noatime /dev/phiblk0 /data 2>/dev/console; then
		# /opt/phi, /root and /home live on the disk. Root's .ssh comes from
		# the image on every boot, so a rebuilt image stays authoritative.
		/bin/busybox mkdir -p /data/opt/phi /data/root /data/home /opt/phi /home
		/bin/busybox cp -a /root/.ssh /data/root/
		/bin/busybox mount --bind /data/opt/phi /opt/phi
		/bin/busybox mount --bind /data/root /root
		/bin/busybox mount --bind /data/home /home
		disk="/dev/phiblk0 on /data, $(/bin/busybox df -h /data | /bin/busybox awk 'NR==2 {print $2" total, "$4" free"}')"
	else
		disk="/dev/phiblk0 present but not mounted"
	fi
fi
# Host memory as swap: /dev/phiblk1 is host RAM served over the ring (kernel
# patch 0026, phictl boot --host-mem). Volatile, so it is formatted at every
# boot; it extends the card's 6 GB.
swap="no host memory"
i=0
while [ $i -lt 3 ] && [ ! -b /dev/phiblk1 ]; do /bin/busybox sleep 1; i=$((i+1)); done
if [ -b /dev/phiblk1 ]; then
	if /bin/busybox mkswap /dev/phiblk1 > /dev/null 2>&1 && /bin/busybox swapon /dev/phiblk1 2>/dev/console; then
		swap="host memory as swap on /dev/phiblk1 ($(/bin/busybox awk '/SwapTotal/ {printf "%d MiB", $2/1024}' /proc/meminfo))"
	else
		swap="/dev/phiblk1 present but swapon failed"
	fi
fi
# phi0 is the Ethernet device over the host/card ring (kernel patch 0021);
# the host side is phictl boot --net phi0, 10.9.0.1/24 by default.
/bin/busybox ip link set lo up
if /bin/busybox ip link show phi0 > /dev/null 2>&1; then
	/bin/busybox ip addr add ${PHI_CARD_ADDR:-10.9.0.2/24} dev phi0
	/bin/busybox ip link set phi0 up
	net="phi0 $(/bin/busybox ip -4 -o addr show phi0 | /bin/busybox awk '{print $4}')"
else
	net="no phi0 device"
fi
if [ -x /bin/dropbear ]; then
	# -s: public keys only (root has no password); keys live in /etc/dropbear.
	# Without syslog support it logs to stderr, kept on the console.
	/bin/dropbear -s -p 22 2>/dev/console
	sshd="dropbear on port 22"
else
	sshd="no SSH server in this image"
fi
if [ -x /bin/phi-agent ] && [ -c /dev/phirpc ]; then
	# The card end of phictl exec/put/get/status (kernel patch 0022).
	/bin/phi-agent 2>/dev/console &
	agent="phi-agent on /dev/phirpc"
else
	agent="no phi-agent"
fi
echo
echo "Intel Phi 3120A: $(/bin/busybox uname -srm), $(/bin/busybox nproc) CPU(s) online"
/bin/busybox grep -m1 "model name" /proc/cpuinfo
/bin/busybox free -m | /bin/busybox head -2
echo "network: $net; $sshd; $agent"
echo "storage: $disk; $swap"
echo "type 'poweroff' to halt the card"
echo
trap '/bin/busybox poweroff -f' USR1 USR2 TERM
while :; do
	/bin/busybox setsid /bin/busybox cttyhack /bin/sh &
	wait $!
	echo "shell exited; starting another ('poweroff' halts the card)"
done
