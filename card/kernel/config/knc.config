# Kconfig fragment for the Knights Corner card kernel.
# Merge onto x86_64 defconfig with scripts/kconfig/merge_config.sh.
# Rationale per line in knc.md. Options starting with CONFIG_X86_KNC come
# from the patch series in ../patches.

CONFIG_X86_64=y
CONFIG_X86_KNC=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_X86_X2APIC=n
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y

# No legacy platform, no ACPI, no PCI bus visible to the card kernel.
CONFIG_ACPI=n
CONFIG_PCI=n
CONFIG_HPET_TIMER=n
CONFIG_X86_MPPARSE=n
CONFIG_RTC_CLASS=n
CONFIG_SERIAL_8250=n
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_X86_16BIT=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_5LEVEL=n
CONFIG_INTEL_IOMMU=n
CONFIG_AMD_IOMMU=n

# Features the core lacks or that emit unsupported instructions.
CONFIG_X86_MCE=n
CONFIG_KVM=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_X86_USER_SHADOW_STACK=n
CONFIG_X86_UMIP=n
CONFIG_X86_SGX=n
CONFIG_X86_FRED=n
CONFIG_MITIGATION_RETPOLINE=n
CONFIG_MITIGATION_RETHUNK=n
CONFIG_MITIGATION_UNRET_ENTRY=n
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=n
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=n
CONFIG_MITIGATION_SRSO=n
CONFIG_MITIGATION_IBRS_ENTRY=n
CONFIG_MITIGATION_SLS=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_CRYPTO_AES_NI_INTEL=n
CONFIG_CRYPTO_SHA256_SSSE3=n
CONFIG_CRYPTO_CRC32C_INTEL=n

# Timekeeping from the LAPIC timer only.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# Boot from initramfs, no block devices needed.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Networking for SSH over the ring transport.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=n
CONFIG_WLAN=n

# Observability.
CONFIG_PERF_EVENTS=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
