From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lasimeri <217267696+Lasimeri@users.noreply.github.com>
Date: Mon, 14 Sep 2026 18:52:29 -0500
Subject: [PATCH] x86/knc: /dev/phirpc, a byte stream to the host tool over
 ring channel 3

The host's phictl daemon and the card's agent exchange framed messages
(commands with their input and output, files) through the ring
region's kind-3 channel. This misc device exposes its two rings as a
file: read() returns bytes the host published, write() appends bytes
for the host, poll() waits for either, one opener at a time, polling
every jiffy while open. The ring copy helpers and the channel lookup
move from the network device into asm/knc_ring.h for both to share.
---
 arch/x86/include/asm/knc_ring.h |  65 +++++++++
 arch/x86/kernel/Makefile        |   2 +-
 arch/x86/kernel/knc_net.c       |  53 +-------
 arch/x86/kernel/knc_rpc.c       | 229 ++++++++++++++++++++++++++++++++
 4 files changed, 297 insertions(+), 52 deletions(-)
 create mode 100644 arch/x86/kernel/knc_rpc.c

diff --git a/arch/x86/include/asm/knc_ring.h b/arch/x86/include/asm/knc_ring.h
index faf3d416c..f9be57011 100644
--- a/arch/x86/include/asm/knc_ring.h
+++ b/arch/x86/include/asm/knc_ring.h
@@ -16,6 +16,7 @@
 #define PHI_REGION_VERSION	1
 #define PHI_CHANNEL_CONSOLE	1
 #define PHI_CHANNEL_NETWORK	2
+#define PHI_CHANNEL_RPC		3	/* command and file transport for the host tool */
 
 /* Region header at offset 0. */
 #define REGION_MAGIC		0
@@ -49,4 +50,68 @@
 #define PHI_NET_HDR		2
 #define PHI_NET_ALIGN		4
 
+#ifndef __ASSEMBLER__
+#include <linux/io.h>
+#include <linux/minmax.h>
+
+/* Copy len bytes out of a ring starting at free-running index pos. */
+static inline void knc_ring_read(void __iomem *ring, u32 size, u32 pos, void *buf, u32 len)
+{
+	u32 off = pos & (size - 1);
+	u32 first = min(len, size - off);
+
+	memcpy_fromio(buf, ring + RING_DATA + off, first);
+	if (len > first)
+		memcpy_fromio(buf + first, ring + RING_DATA, len - first);
+}
+
+/* Copy len bytes into a ring starting at free-running index pos. */
+static inline void knc_ring_write(void __iomem *ring, u32 size, u32 pos, const void *buf, u32 len)
+{
+	u32 off = pos & (size - 1);
+	u32 first = min(len, size - off);
+
+	memcpy_toio(ring + RING_DATA + off, buf, first);
+	if (len > first)
+		memcpy_toio(ring + RING_DATA, buf + first, len - first);
+}
+
+/* A ring is usable when its header agrees with the descriptor. */
+static inline bool knc_ring_valid(void __iomem *ring, u32 size)
+{
+	return size && !(size & (size - 1)) && readl(ring + RING_MAGIC) == PHI_RING_MAGIC &&
+	       readl(ring + RING_SIZE) == size;
+}
+
+/*
+ * knc_ring_find() - Locate a channel of the given kind in a mapped region.
+ * Returns true and the ring offsets and sizes when both rings validate.
+ */
+static inline bool knc_ring_find(void __iomem *region, u64 region_size, u32 kind,
+				 u32 *h2c_off, u32 *h2c_size, u32 *c2h_off, u32 *c2h_size)
+{
+	u32 count, i;
+
+	if (readl(region + REGION_MAGIC) != PHI_REGION_MAGIC)
+		return false;
+	count = min_t(u32, readl(region + REGION_CHANNEL_COUNT), 8);
+	for (i = 0; i < count; i++) {
+		void __iomem *desc = region + REGION_DESC(i);
+
+		if (readl(desc + DESC_KIND) != kind)
+			continue;
+		*h2c_off = readl(desc + DESC_H2C_OFFSET);
+		*h2c_size = readl(desc + DESC_H2C_SIZE);
+		*c2h_off = readl(desc + DESC_C2H_OFFSET);
+		*c2h_size = readl(desc + DESC_C2H_SIZE);
+		return *h2c_size && *c2h_size &&
+		       (u64)*h2c_off + RING_DATA + *h2c_size <= region_size &&
+		       (u64)*c2h_off + RING_DATA + *c2h_size <= region_size &&
+		       knc_ring_valid(region + *h2c_off, *h2c_size) &&
+		       knc_ring_valid(region + *c2h_off, *c2h_size);
+	}
+	return false;
+}
+#endif /* !__ASSEMBLER__ */
+
 #endif /* _ASM_X86_KNC_RING_H */
