diff --git a/arch/x86/include/asm/knc_ring.h b/arch/x86/include/asm/knc_ring.h
new file mode 100644
index 000000000..faf3d416c
--- /dev/null
+++ b/arch/x86/include/asm/knc_ring.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Layout of the host/card ring region on Knights Corner, protocol v1
+ * (docs/spec/ring-protocol.md in the host repository). The host formats the
+ * region in card memory before it starts the kernel; the ring console
+ * (knc_earlycon.c, knc_tty.c) and the ring network device (knc_net.c) map
+ * it and attach to their channel by kind. Offsets are in bytes; every field
+ * is a little-endian u32 unless noted. All structures are 64-byte aligned
+ * so that no two fields written by different sides share a cache line.
+ */
+#ifndef _ASM_X86_KNC_RING_H
+#define _ASM_X86_KNC_RING_H
+
+#define PHI_REGION_MAGIC	0x52494850	/* "PHIR" */
+#define PHI_RING_MAGIC		0x474E4952	/* "RING" */
+#define PHI_REGION_VERSION	1
+#define PHI_CHANNEL_CONSOLE	1
+#define PHI_CHANNEL_NETWORK	2
+
+/* Region header at offset 0. */
+#define REGION_MAGIC		0
+#define REGION_VERSION		4
+#define REGION_SIZE		8
+#define REGION_CHANNEL_COUNT	12
+#define REGION_HOST_EPOCH_NS	16	/* u64: host wall clock at boot */
+#define REGION_CARD_BOOT_FLAGS	24	/* u64, written by the card */
+#define REGION_DESC(i)		(64 + 64 * (i))
+
+/* Channel descriptor, 64 bytes each from offset 64. */
+#define DESC_KIND		0
+#define DESC_FLAGS		4
+#define DESC_H2C_OFFSET		8	/* host-to-card ring, region offset */
+#define DESC_H2C_SIZE		12	/* data bytes, power of two */
+#define DESC_C2H_OFFSET		16	/* card-to-host ring */
+#define DESC_C2H_SIZE		20
+
+/* One ring per direction: header, then `size` data bytes at RING_DATA. */
+#define RING_MAGIC		0
+#define RING_SIZE		4
+#define RING_HEAD		64	/* producer index, free-running mod 2^32 */
+#define RING_TAIL		128	/* consumer index */
+#define RING_DATA		192
+
+/*
+ * Network channel records: u16 frame length, the Ethernet frame, padding to
+ * a multiple of 4 bytes. A record never straddles a publish: the producer
+ * writes it whole, then publishes the new head.
+ */
+#define PHI_NET_HDR		2
+#define PHI_NET_ALIGN		4
+
+#endif /* _ASM_X86_KNC_RING_H */
