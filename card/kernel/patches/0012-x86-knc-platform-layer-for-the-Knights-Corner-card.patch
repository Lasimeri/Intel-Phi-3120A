diff --git a/arch/x86/boot/compressed/misc.c b/arch/x86/boot/compressed/misc.c
index 0f41ca0e5..6e8e4d56b 100644
--- a/arch/x86/boot/compressed/misc.c
+++ b/arch/x86/boot/compressed/misc.c
@@ -404,6 +404,29 @@ static void early_sev_detect(void)
  *             |-------uncompressed kernel image---------|
  *
  */
+#ifdef CONFIG_X86_KNC
+/*
+ * Knights Corner: report progress in the DBOX POST code register the host
+ * reads (asm/knc.h has the same constants; this file stays self-contained).
+ * Only when running on the card (CPUID family 0x0b), so the image still
+ * boots elsewhere. The address is above 4 GiB and is identity-mapped on
+ * demand by the decompressor's page fault handler.
+ */
+static void knc_post(u32 code)
+{
+	u32 eax, ebx, ecx, edx;
+
+	asm volatile("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1));
+	if (((eax >> 8) & 0xf) != 0x0b)
+		return;
+	*(volatile u32 *)(0x08007C0000ULL + 0x242c) = code;
+}
+#define KNC_POST(a, b)	((u32)(a) | ((u32)(b) << 8))
+#else
+static inline void knc_post(u32 code) { }
+#define KNC_POST(a, b)	0
+#endif
+
 asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 {
 	unsigned long virt_addr = LOAD_PHYSICAL_ADDR;
@@ -413,6 +436,7 @@ asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 
 	/* Retain x86 boot parameters pointer passed from startup_32/64. */
 	boot_params_ptr = rmode;
+	knc_post(KNC_POST('K', '0'));
 
 	/* Clear flags intended for solely in-kernel use. */
 	boot_params_ptr->hdr.loadflags &= ~KASLR_FLAG;
@@ -533,5 +557,6 @@ asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 		error_putstr("\n");
 	}
 
+	knc_post(KNC_POST('K', '1'));
 	return output + entry_offset;
 }
