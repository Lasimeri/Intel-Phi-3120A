+++ b/arch/x86/kernel/head64.c
@@ -42,6 +42,7 @@
 #include <asm/sev.h>
 #include <asm/tdx.h>
 #include <asm/init.h>
+#include <asm/knc.h>
 
 /*
  * Manage page tables very early on.
@@ -221,6 +222,7 @@ static void __init copy_bootdata(char *real_mode_data)
 
 asmlinkage __visible void __init __noreturn x86_64_start_kernel(char * real_mode_data)
 {
+	knc_boot_mark = KNC_POST('K', 'O'); /* first C code entered */
 	/*
 	 * Build-time sanity checks on the kernel image and module
 	 * area mappings. (these are purely build-time and produce no code)
@@ -247,6 +249,7 @@ asmlinkage __visible void __init __noreturn x86_64_start_kernel(char * real_mode
 	}
 
 	clear_bss();
+	knc_boot_mark = KNC_POST('K', 'Q'); /* bss cleared */
 
 	/*
 	 * This needs to happen *before* kasan_early_init() because latter maps stuff
@@ -274,6 +277,8 @@ asmlinkage __visible void __init __noreturn x86_64_start_kernel(char * real_mode
 	__native_tlb_flush_global(this_cpu_read(cpu_tlbstate.cr4));
 
 	idt_setup_early_handler();
+	knc_boot_mark = KNC_POST('K', 'R'); /* early exception handlers installed */
+	knc_early_post(KNC_POST_EARLY_C);   /* first repaired page fault */
 
 	/* Needed before cc_platform_has() can be used for TDX */
 	tdx_early_init();
diff --git a/arch/x86/kernel/head_64.S b/arch/x86/kernel/head_64.S
index f882849c3..6af9b4131 100644
--- a/arch/x86/kernel/head_64.S
+++ b/arch/x86/kernel/head_64.S
@@ -61,6 +61,16 @@ SYM_CODE_START_NOALIGN(startup_64)
 	/* Set up the stack for verify_cpu() */
