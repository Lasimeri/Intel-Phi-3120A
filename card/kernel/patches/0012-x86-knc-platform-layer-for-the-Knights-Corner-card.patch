diff --git a/arch/x86/include/asm/knc.h b/arch/x86/include/asm/knc.h
index 058061414..bce9a4165 100644
--- a/arch/x86/include/asm/knc.h
+++ b/arch/x86/include/asm/knc.h
@@ -17,6 +17,8 @@
 #define KNC_DBOX_PHYS		0x08007C0000ULL
 #define KNC_SBOX_PHYS		0x08007D0000ULL
 #define KNC_BOX_SIZE		0x10000
+/* First address that is not card memory: register blocks from 32 GiB, the SMPT window onto host memory from 512 GiB. */
+#define KNC_MMIO_BASE		0x0800000000ULL
 
 /* DBOX: the POST code register the host reads at BAR4 + 0x242c. */
 #define KNC_DBOX_POSTCODE	0x242c
@@ -43,6 +45,15 @@
 #define KNC_POST_HALT		KNC_POST('K', 'H')
 #define KNC_POST_PANIC		KNC_POST('K', 'P')
 #define KNC_POST_ERROR		KNC_POST('K', 'E')
+/* Early milestones, before the platform layer (K2). */
+#define KNC_POST_ASM_ENTRY	KNC_POST('K', '8')	/* startup_64 entered (head_64.S) */
+#define KNC_POST_EARLY_C	KNC_POST('K', '9')	/* x86_64_start_kernel, early exceptions set up */
+#define KNC_POST_SETUP_ARCH	KNC_POST('K', 'A')	/* setup_arch entered */
+#define KNC_POST_CPU_INIT	KNC_POST('K', 'B')	/* early_cpu_init done */
+#define KNC_POST_E820		KNC_POST('K', 'C')	/* memory map set up */
+#define KNC_POST_EARLY_PARAM	KNC_POST('K', 'D')	/* early parameters parsed */
+/* Written by head_64.S with literal bytes: "KF" verify_cpu passed, "KG" page
+ * tables built (before the CR3 switch), "KI" early IDT loaded. */
 
 #define KNC_MAX_CPUS		256
 #define KNC_MAX_IOAPICS		4
@@ -73,5 +84,41 @@ u64 knc_ring_host_epoch_ns(void);
 
 /* Platform layer (knc.c). */
 void knc_postcode(u32 code);
+/*
+ * A progress word in .data (never .bss: clear_bss() would wipe it) that
+ * head_64.S writes with plain stores from the moment the kernel's own page
+ * tables are live, before any MMIO or page-fault handling exists. The host
+ * reads it from card memory at LOAD_PHYSICAL_ADDR + (address - kernel
+ * virtual base); phictl boot --watch prints changes. Values are ASCII
+ * pairs like the POST codes: "KJ" CR3 loaded, "KL" at the virtual address,
+ * "KM" stack and GS set, "KN" early IDT loaded.
+ */
+extern u32 knc_boot_mark;
+
+#ifndef __ASSEMBLER__
+#include <asm/page.h>
+
+static inline bool knc_is_this_cpu(void)
+{
+	unsigned int eax, ebx, ecx, edx;
+
+	asm volatile("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1));
+	return ((eax >> 8) & 0xf) == 0x0b;
+}
+
+/*
+ * Progress code from code that runs before early_ioremap() works. The DBOX
+ * page is reached through its direct-map address; the early page-fault
+ * handler maps such addresses on demand (head64.c), and the bootstrap's
+ * MTRRs keep the block uncached (the decompressor writes the same register
+ * through a cacheable identity map and the host sees it). Usable from
+ * x86_64_start_kernel() after idt_setup_early_handler().
+ */
+static inline void knc_early_post(u32 code)
+{
+	if (IS_ENABLED(CONFIG_X86_KNC) && knc_is_this_cpu())
+		*(volatile u32 *)__va(KNC_DBOX_PHYS + KNC_DBOX_POSTCODE) = code;
+}
+#endif /* !__ASSEMBLER__ */
 
 #endif /* _ASM_X86_KNC_H */
