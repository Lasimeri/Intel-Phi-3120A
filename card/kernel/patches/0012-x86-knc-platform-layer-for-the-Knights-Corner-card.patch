From: Lasimeri <217267696+Lasimeri@users.noreply.github.com>
Date: Sun, 13 Sep 2026 22:18:17 -0500
Subject: [PATCH 12/15] x86/knc: platform layer for the Knights Corner card

Hook the Xeon Phi x100 card into setup_arch() through the hypervisor
detection table, as arch/x86/kernel/jailhouse.c does, with detection by
CPUID (family 0x0b, model 0x01) and the native hypervisor type so that
nothing else changes behavior. The platform init:

- maps the DBOX and SBOX register blocks and writes progress codes to
  the POST register the host reads at BAR4 + 0x242c ('K' plus a
  character; the decompressor writes "K0" on entry and "K1" before
  jumping to the kernel);
- reads the bootstrap's SFI tables and registers CPUs and the I/O APIC
  (64-bit address) from them, with the local APIC at its architectural
  default (SSDG 328207-002 sections 2.2.4.2, 4.2.4, 4.2.5); falls back
  to the SFI memory map only if boot_params carries no e820 entries;
- removes every legacy device: PIC, PIT, HPET, RTC, i8042, VGA, ROM
  probing (4.2.2);
- reports the core clock, decoded from SBOX SCRATCH4 and
  CURRENT_CLK_RATIO the way Intel's card kernel did (overridable with
  knc.core_khz=), as the TSC rate; calibrate_APIC_clock() then measures
  the LAPIC timer against the TSC, so no PIT is needed (4.2.6);
- takes the wall clock from the host's epoch in the ring region header
  (4.2.6);
- clears PGE before any CR4 write, forces ARAT and the TSC flags
  (4.2.10, 4.2.17.1);
- halts on restart, power-off and panic with a POST code, since reset
  is the host's job through SBOX RGCR.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/x86/boot/compressed/misc.c   |  25 +++
 arch/x86/include/asm/hypervisor.h |   1 +
 arch/x86/kernel/Makefile          |   2 +-
 arch/x86/kernel/cpu/hypervisor.c  |   3 +
 arch/x86/kernel/knc.c             | 309 ++++++++++++++++++++++++++++++
 5 files changed, 339 insertions(+), 1 deletion(-)
 create mode 100644 arch/x86/kernel/knc.c

diff --git a/arch/x86/boot/compressed/misc.c b/arch/x86/boot/compressed/misc.c
index 0f41ca0e5..6e8e4d56b 100644
--- a/arch/x86/boot/compressed/misc.c
+++ b/arch/x86/boot/compressed/misc.c
@@ -404,6 +404,29 @@ static void early_sev_detect(void)
  *             |-------uncompressed kernel image---------|
  *
  */
+#ifdef CONFIG_X86_KNC
+/*
+ * Knights Corner: report progress in the DBOX POST code register the host
+ * reads (asm/knc.h has the same constants; this file stays self-contained).
+ * Only when running on the card (CPUID family 0x0b), so the image still
+ * boots elsewhere. The address is above 4 GiB and is identity-mapped on
+ * demand by the decompressor's page fault handler.
+ */
+static void knc_post(u32 code)
+{
+	u32 eax, ebx, ecx, edx;
+
+	asm volatile("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1));
+	if (((eax >> 8) & 0xf) != 0x0b)
+		return;
+	*(volatile u32 *)(0x08007C0000ULL + 0x242c) = code;
+}
+#define KNC_POST(a, b)	((u32)(a) | ((u32)(b) << 8))
+#else
+static inline void knc_post(u32 code) { }
+#define KNC_POST(a, b)	0
+#endif
+
 asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 {
 	unsigned long virt_addr = LOAD_PHYSICAL_ADDR;
@@ -413,6 +436,7 @@ asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 
 	/* Retain x86 boot parameters pointer passed from startup_32/64. */
 	boot_params_ptr = rmode;
+	knc_post(KNC_POST('K', '0'));
 
 	/* Clear flags intended for solely in-kernel use. */
 	boot_params_ptr->hdr.loadflags &= ~KASLR_FLAG;
@@ -533,5 +557,6 @@ asmlinkage __visible void *extract_kernel(void *rmode, unsigned char *output)
 		error_putstr("\n");
 	}
 
+	knc_post(KNC_POST('K', '1'));
 	return output + entry_offset;
 }
