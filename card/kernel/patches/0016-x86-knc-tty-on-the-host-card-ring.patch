diff --git a/arch/x86/kernel/knc_tty.c b/arch/x86/kernel/knc_tty.c
new file mode 100644
index 000000000..e1b73a6a9
--- /dev/null
+++ b/arch/x86/kernel/knc_tty.c
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * knc_tty: a tty on the host/card ring, so that init gets /dev/console and
+ * lines typed into "phictl console" on the host reach the card.
+ *
+ * Output goes into the card-to-host console ring through the same path as
+ * the early console (knc_earlycon.c). Input is polled from the host-to-card
+ * ring every 10 ms by a delayed work: v1 of the ring protocol signals
+ * nothing, and a poll that short is invisible next to a human typing.
+ * The console is "ttyPHI0"; console=ttyPHI0 makes it the kernel console and
+ * the boot console (earlyprintk=phiring) is dropped when it registers.
+ */
+
+#define pr_fmt(fmt) "KNC: tty: " fmt
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+#include <linux/workqueue.h>
+
+#include <asm/knc.h>
+
+#define KNC_TTY_POLL_MS	10
+
+static struct tty_driver *knc_tty_driver;
+static struct tty_port knc_tty_port;
+static struct delayed_work knc_rx_work;
+
+static void knc_rx_poll(struct work_struct *work)
+{
+	u8 buf[256];
+	int n;
+
+	while ((n = knc_ring_con_read(buf, sizeof(buf))) > 0) {
+		tty_insert_flip_string(&knc_tty_port, buf, n);
+		tty_flip_buffer_push(&knc_tty_port);
+	}
+	schedule_delayed_work(&knc_rx_work, msecs_to_jiffies(KNC_TTY_POLL_MS));
+}
+
+static int knc_tty_open(struct tty_struct *tty, struct file *filp)
+{
+	return tty_port_open(&knc_tty_port, tty, filp);
+}
+
+static void knc_tty_close(struct tty_struct *tty, struct file *filp)
+{
+	tty_port_close(&knc_tty_port, tty, filp);
+}
+
+static ssize_t knc_tty_write(struct tty_struct *tty, const u8 *buf, size_t count)
+{
+	knc_ring_con_write(buf, count);
+	return count;
+}
+
+static unsigned int knc_tty_write_room(struct tty_struct *tty)
+{
+	return 4096;
+}
+
+static const struct tty_operations knc_tty_ops = {
+	.open		= knc_tty_open,
+	.close		= knc_tty_close,
+	.write		= knc_tty_write,
+	.write_room	= knc_tty_write_room,
+};
+
+static const struct tty_port_operations knc_tty_port_ops = {
+};
+
+static void knc_console_write(struct console *co, const char *s, unsigned int n)
+{
+	knc_ring_con_write(s, n);
+}
+
+static struct tty_driver *knc_console_device(struct console *co, int *index)
+{
+	*index = 0;
+	return knc_tty_driver;
+}
+
+static struct console knc_console = {
+	.name	= "ttyPHI",
+	.write	= knc_console_write,
+	.device	= knc_console_device,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+static int __init knc_tty_init(void)
+{
+	struct tty_driver *drv;
+	int ret;
+
+	if (!knc_ring_permanent())
+		return -ENODEV;
+	drv = tty_alloc_driver(1, TTY_DRIVER_REAL_RAW);
+	if (IS_ERR(drv))
+		return PTR_ERR(drv);
+	drv->driver_name = "knc_tty";
+	drv->name = "ttyPHI";
+	drv->type = TTY_DRIVER_TYPE_SERIAL;
+	drv->subtype = SERIAL_TYPE_NORMAL;
+	drv->init_termios = tty_std_termios;
+	drv->init_termios.c_cflag = B115200 | CS8 | CREAD | HUPCL | CLOCAL;
+	tty_port_init(&knc_tty_port);
+	knc_tty_port.ops = &knc_tty_port_ops;
+	tty_port_link_device(&knc_tty_port, drv, 0);
+	tty_set_operations(drv, &knc_tty_ops);
+	ret = tty_register_driver(drv);
+	if (ret) {
+		tty_port_destroy(&knc_tty_port);
+		tty_driver_kref_put(drv);
+		return ret;
+	}
+	knc_tty_driver = drv;
+	INIT_DELAYED_WORK(&knc_rx_work, knc_rx_poll);
+	schedule_delayed_work(&knc_rx_work, msecs_to_jiffies(KNC_TTY_POLL_MS));
+	register_console(&knc_console);
+	pr_info("ttyPHI0 on the ring, polling input every %d ms\n", KNC_TTY_POLL_MS);
+	return 0;
+}
+device_initcall(knc_tty_init);
