+static bool knc_ring_ok(void __iomem *ring, u32 size)
+{
+	return readl(ring + RING_MAGIC) == PHI_RING_MAGIC && readl(ring + RING_SIZE) == size;
+}
+
+/**
+ * knc_ring_con_write() - Append bytes to the card-to-host console ring.
+ *
+ * Shared by the early console and the tty; the lock serializes them. A
+ * full ring drops bytes rather than stalling the writer.
+ */
+void knc_ring_con_write(const char *s, unsigned int n)
 {
-	u32 head = knc_con_head;
-	u32 tail;
+	unsigned long flags;
+	u32 head, tail;
 
 	if (!knc_con)
 		return;
+	raw_spin_lock_irqsave(&knc_con_lock, flags);
+	head = knc_con_head;
 	tail = readl(knc_con + RING_TAIL);
 	while (n--) {
 		if (head - tail >= knc_con_size) {
-			/* Host has not drained the ring; drop rather than stall boot. */
 			knc_con_dropped += n + 1;
 			break;
 		}
@@ -147,6 +165,45 @@ static void knc_earlycon_write(struct console *con, const char *s, unsigned int
 	wmb();
 	writel(head, knc_con + RING_HEAD);
 	knc_con_head = head;
+	raw_spin_unlock_irqrestore(&knc_con_lock, flags);
+}
+
+/**
+ * knc_ring_con_read() - Take bytes the host wrote into the host-to-card ring.
+ *
+ * Returns the number of bytes copied, 0 when nothing is pending or the
+ * permanent mapping is not up yet.
+ */
+int knc_ring_con_read(u8 *buf, int len)
+{
+	u32 head, tail;
+	int n = 0;
+
+	if (!knc_in)
+		return 0;
+	head = readl(knc_in + RING_HEAD);
+	tail = knc_in_tail;
+	while (n < len && head - tail > 0) {
+		buf[n++] = readb(knc_in + RING_DATA + (tail % knc_in_size));
+		tail++;
+	}
+	if (n) {
+		wmb();
+		writel(tail, knc_in + RING_TAIL);
+		knc_in_tail = tail;
+	}
+	return n;
+}
+
+/* True once the permanent (ioremap) mapping is in place; the tty needs it. */
+bool knc_ring_permanent(void)
+{
+	return knc_region && !knc_region_is_early;
+}
+
+static void knc_earlycon_write(struct console *con, const char *s, unsigned int n)
+{
+	knc_ring_con_write(s, n);
