diff --git a/arch/x86/kernel/knc_hostmem.c b/arch/x86/kernel/knc_hostmem.c
new file mode 100644
index 000000000..0112a7af0
--- /dev/null
+++ b/arch/x86/kernel/knc_hostmem.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * knc_hostmem.c - /dev/phihost: host memory mapped into the card.
+ *
+ * The host tool pins a shared file (phictl boot --host-mem SIZE) and maps
+ * it for the card through the system memory page table; the card reaches
+ * it at a 40-bit address in the system range (0x80_0000_0000 and up, SSDG
+ * 328207-002 section 2.1.12), announced in the ring region header
+ * (asm/knc_ring.h, REGION_HOSTMEM_ADDR and _SIZE). This device exposes
+ * that window: read() and write() copy through it, mmap() maps it
+ * uncached into a process, so a card program and a host program share the
+ * bytes with no copy at all. Every access is a PCIe transaction, so it is
+ * a control and exchange surface, not fast bulk memory; for bulk the same
+ * memory is /dev/phiblk1 through the DMA engine (knc_blk.c). Root only.
+ */
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <asm/knc.h>
+#include <asm/knc_ring.h>
+
+#define KNC_HOSTMEM_CHUNK	SZ_64K
+
+struct knc_hostmem {
+	u64 addr;			/* card address of the window */
+	u64 size;
+	void __iomem *map;		/* the whole window, uncached */
+	struct mutex lock;		/* serialises the bounce buffer */
+	u8 *bounce;
+	struct miscdevice misc;
+};
+
+static struct knc_hostmem *knc_hostmem;
+
+static loff_t knc_hostmem_llseek(struct file *file, loff_t off, int whence)
+{
+	struct knc_hostmem *h = file->private_data;
+
+	return fixed_size_llseek(file, off, whence, h->size);
+}
+
+static ssize_t knc_hostmem_read(struct file *file, char __user *buf, size_t count, loff_t *ppos)
+{
+	struct knc_hostmem *h = file->private_data;
+	size_t done = 0;
+
+	if (*ppos >= h->size)
+		return 0;
+	count = min_t(u64, count, h->size - *ppos);
+	if (mutex_lock_interruptible(&h->lock))
+		return -ERESTARTSYS;
+	while (done < count) {
+		size_t n = min_t(size_t, count - done, KNC_HOSTMEM_CHUNK);
+
+		memcpy_fromio(h->bounce, h->map + *ppos + done, n);
+		if (copy_to_user(buf + done, h->bounce, n)) {
+			mutex_unlock(&h->lock);
+			return done ? done : -EFAULT;
+		}
+		done += n;
+	}
+	mutex_unlock(&h->lock);
+	*ppos += done;
+	return done;
+}
+
+static ssize_t knc_hostmem_write(struct file *file, const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct knc_hostmem *h = file->private_data;
+	size_t done = 0;
+
+	if (*ppos >= h->size)
+		return -ENOSPC;
+	count = min_t(u64, count, h->size - *ppos);
+	if (mutex_lock_interruptible(&h->lock))
+		return -ERESTARTSYS;
+	while (done < count) {
+		size_t n = min_t(size_t, count - done, KNC_HOSTMEM_CHUNK);
+
+		if (copy_from_user(h->bounce, buf + done, n)) {
+			mutex_unlock(&h->lock);
+			return done ? done : -EFAULT;
+		}
+		memcpy_toio(h->map + *ppos + done, h->bounce, n);
+		done += n;
+	}
+	mutex_unlock(&h->lock);
+	*ppos += done;
+	return done;
+}
+
+/* Map part of the window uncached; offset and length come from the caller. */
+static int knc_hostmem_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct knc_hostmem *h = file->private_data;
+	u64 off = (u64)vma->vm_pgoff << PAGE_SHIFT;
+	u64 len = vma->vm_end - vma->vm_start;
+
+	if (off >= h->size || len > h->size - off)
+		return -EINVAL;
+	vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+	return io_remap_pfn_range(vma, vma->vm_start, (h->addr + off) >> PAGE_SHIFT, len, vma->vm_page_prot);
+}
+
+static int knc_hostmem_open(struct inode *inode, struct file *file)
+{
+	file->private_data = knc_hostmem;
+	return 0;
+}
+
+static const struct file_operations knc_hostmem_fops = {
+	.owner		= THIS_MODULE,
+	.open		= knc_hostmem_open,
+	.llseek		= knc_hostmem_llseek,
+	.read		= knc_hostmem_read,
+	.write		= knc_hostmem_write,
+	.mmap		= knc_hostmem_mmap,
+};
+
+static int __init knc_hostmem_init(void)
+{
+	struct knc_hostmem *h;
+	void __iomem *region;
+	u64 base, size, addr, len;
+	int err;
+
+	if (!knc_ring_params(&base, &size))
+		return -ENODEV;
+	region = ioremap(base, size);
+	if (!region)
+		return -ENOMEM;
+	addr = readq(region + REGION_HOSTMEM_ADDR);
+	len = readq(region + REGION_HOSTMEM_SIZE);
+	iounmap(region);
+	if (!len)
+		return -ENODEV;
+	h = kzalloc(sizeof(*h), GFP_KERNEL);
+	if (!h)
+		return -ENOMEM;
+	h->bounce = kmalloc(KNC_HOSTMEM_CHUNK, GFP_KERNEL);
+	h->map = ioremap(addr, len);
+	if (!h->bounce || !h->map) {
+		err = -ENOMEM;
+		goto out;
+	}
+	h->addr = addr;
+	h->size = len;
+	mutex_init(&h->lock);
+	h->misc.minor = MISC_DYNAMIC_MINOR;
+	h->misc.name = "phihost";
+	h->misc.fops = &knc_hostmem_fops;
+	h->misc.mode = 0600;
+	knc_hostmem = h;
+	err = misc_register(&h->misc);
+	if (err)
+		goto out;
+	pr_info("KNC: hostmem: %llu MiB of host memory at card address %#llx, /dev/phihost\n", len >> 20, addr);
+	return 0;
+
+out:
+	if (h->map)
+		iounmap(h->map);
+	kfree(h->bounce);
+	kfree(h);
+	knc_hostmem = NULL;
+	return err;
+}
+device_initcall(knc_hostmem_init);
