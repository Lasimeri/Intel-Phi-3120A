From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian Haapanen <ian.haapanen@gmail.com>
Date: Tue, 15 Sep 2026 15:02:27 -0500
Subject: [PATCH] x86/knc: save and restore the vector unit state on context
 switch

Knights Corner keeps its 512-bit vector unit outside the FXSAVE image:
FXSAVE stores nothing of the 32 zmm registers and FXRSTOR clears bits
0:127 of every one of them (ISA reference 327364-001, appendix B.5 and
B.4). Without help from the kernel a user task using the vector unit
loses its registers at every context switch, which vpu_state.c in the
project tree measured as one mismatch in five checks with one thread per
CPU and four in five with two.

Add asm/knc_vpu.h with knc_vpu_save() and knc_vpu_restore(), inline
assembly of byte-encoded vector stores, loads and mask register moves
(no assembler in the stack knows the MVEX prefix; the header is generated
by knc-mvex-gen from the project's encoder, whose tests pin the bytes to
Intel's k1om kernel macros), and keep 2112 bytes of vector state after
the 512-byte FXSAVE image in every task's fpstate. save_fpregs_to_fpstate
stores the vector state after fxsave; restore_fpregs_from_fpstate loads
it after fxrstor, which is the order the B.4 note requires. The user ABI
(signal frames, ptrace) keeps the FXSAVE image only: a signal handler
that used the vector unit would clobber the interrupted code's registers,
as on Intel's k1om tree before its xsave emulation.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/x86/include/asm/knc_vpu.h | 135 +++++++++++++++++++++++++++++++++
 arch/x86/kernel/fpu/core.c     |  15 +++-
 arch/x86/kernel/fpu/init.c     |  14 ++++
 3 files changed, 162 insertions(+), 2 deletions(-)
 create mode 100644 arch/x86/include/asm/knc_vpu.h

diff --git a/arch/x86/include/asm/knc_vpu.h b/arch/x86/include/asm/knc_vpu.h
new file mode 100644
index 000000000..77c5d7a9d
--- /dev/null
+++ b/arch/x86/include/asm/knc_vpu.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Knights Corner vector unit state: 32 zmm registers of 64 bytes and 8
+ * mask registers of 16 bits, kept after the FXSAVE image in the task's
+ * fpstate. FXSAVE does not store the zmm registers and FXRSTOR clears
+ * bits 0:127 of every one of them (ISA reference 327364-001, B.5 and
+ * B.4), so the restore has to run after fxrstor.
+ *
+ * Generated by knc-mvex-gen kernel-header (host/crates/knc-mvex in the
+ * project tree), whose tests pin the encodings to Intel's k1om kernel
+ * macros. Vector instructions are byte sequences because the assembler
+ * does not know the MVEX prefix.
+ */
+#ifndef _ASM_X86_KNC_VPU_H
+#define _ASM_X86_KNC_VPU_H
+
+#define KNC_VPU_STATE_OFFSET	512	/* right after the FXSAVE image */
+#define KNC_VPU_K_OFFSET	2048	/* the mask registers, after the zmm registers */
+#define KNC_VPU_STATE_SIZE	2112	/* zmm and masks, rounded up to 64 bytes */
+#define KNC_FPSTATE_SIZE	(KNC_VPU_STATE_OFFSET + KNC_VPU_STATE_SIZE)
+
+#ifndef __ASSEMBLY__
+
+/* Store zmm0..31 and k0..k7 into a 64-byte aligned area of KNC_VPU_STATE_SIZE bytes. */
+static inline void knc_vpu_save(void *area)
+{
+	asm volatile(
+		".byte 0x62,0xf1,0x78,0x08,0x29,0x80,0x00,0x00,0x00,0x00\n\t" /* vmovaps [rax+0], zmm0 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0x88,0x40,0x00,0x00,0x00\n\t" /* vmovaps [rax+64], zmm1 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0x90,0x80,0x00,0x00,0x00\n\t" /* vmovaps [rax+128], zmm2 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0x98,0xc0,0x00,0x00,0x00\n\t" /* vmovaps [rax+192], zmm3 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0xa0,0x00,0x01,0x00,0x00\n\t" /* vmovaps [rax+256], zmm4 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0xa8,0x40,0x01,0x00,0x00\n\t" /* vmovaps [rax+320], zmm5 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0xb0,0x80,0x01,0x00,0x00\n\t" /* vmovaps [rax+384], zmm6 */
+		".byte 0x62,0xf1,0x78,0x08,0x29,0xb8,0xc0,0x01,0x00,0x00\n\t" /* vmovaps [rax+448], zmm7 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0x80,0x00,0x02,0x00,0x00\n\t" /* vmovaps [rax+512], zmm8 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0x88,0x40,0x02,0x00,0x00\n\t" /* vmovaps [rax+576], zmm9 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0x90,0x80,0x02,0x00,0x00\n\t" /* vmovaps [rax+640], zmm10 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0x98,0xc0,0x02,0x00,0x00\n\t" /* vmovaps [rax+704], zmm11 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0xa0,0x00,0x03,0x00,0x00\n\t" /* vmovaps [rax+768], zmm12 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0xa8,0x40,0x03,0x00,0x00\n\t" /* vmovaps [rax+832], zmm13 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0xb0,0x80,0x03,0x00,0x00\n\t" /* vmovaps [rax+896], zmm14 */
+		".byte 0x62,0x71,0x78,0x08,0x29,0xb8,0xc0,0x03,0x00,0x00\n\t" /* vmovaps [rax+960], zmm15 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0x80,0x00,0x04,0x00,0x00\n\t" /* vmovaps [rax+1024], zmm16 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0x88,0x40,0x04,0x00,0x00\n\t" /* vmovaps [rax+1088], zmm17 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0x90,0x80,0x04,0x00,0x00\n\t" /* vmovaps [rax+1152], zmm18 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0x98,0xc0,0x04,0x00,0x00\n\t" /* vmovaps [rax+1216], zmm19 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0xa0,0x00,0x05,0x00,0x00\n\t" /* vmovaps [rax+1280], zmm20 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0xa8,0x40,0x05,0x00,0x00\n\t" /* vmovaps [rax+1344], zmm21 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0xb0,0x80,0x05,0x00,0x00\n\t" /* vmovaps [rax+1408], zmm22 */
+		".byte 0x62,0xe1,0x78,0x08,0x29,0xb8,0xc0,0x05,0x00,0x00\n\t" /* vmovaps [rax+1472], zmm23 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0x80,0x00,0x06,0x00,0x00\n\t" /* vmovaps [rax+1536], zmm24 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0x88,0x40,0x06,0x00,0x00\n\t" /* vmovaps [rax+1600], zmm25 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0x90,0x80,0x06,0x00,0x00\n\t" /* vmovaps [rax+1664], zmm26 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0x98,0xc0,0x06,0x00,0x00\n\t" /* vmovaps [rax+1728], zmm27 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0xa0,0x00,0x07,0x00,0x00\n\t" /* vmovaps [rax+1792], zmm28 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0xa8,0x40,0x07,0x00,0x00\n\t" /* vmovaps [rax+1856], zmm29 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0xb0,0x80,0x07,0x00,0x00\n\t" /* vmovaps [rax+1920], zmm30 */
+		".byte 0x62,0x61,0x78,0x08,0x29,0xb8,0xc0,0x07,0x00,0x00\n\t" /* vmovaps [rax+1984], zmm31 */
+		".byte 0xc5,0xf8,0x93,0xc8\n\t" /* kmov ecx, k0 */
+		"movw %%cx, 2048(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xc9\n\t" /* kmov ecx, k1 */
+		"movw %%cx, 2050(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xca\n\t" /* kmov ecx, k2 */
+		"movw %%cx, 2052(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xcb\n\t" /* kmov ecx, k3 */
+		"movw %%cx, 2054(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xcc\n\t" /* kmov ecx, k4 */
+		"movw %%cx, 2056(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xcd\n\t" /* kmov ecx, k5 */
+		"movw %%cx, 2058(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xce\n\t" /* kmov ecx, k6 */
+		"movw %%cx, 2060(%%rax)\n\t"
+		".byte 0xc5,0xf8,0x93,0xcf\n\t" /* kmov ecx, k7 */
+		"movw %%cx, 2062(%%rax)\n\t"
+		: : "a" (area) : "rcx", "memory");
+}
+
+/* Load them back; call after fxrstor, which zeroes the low 128 bits of each zmm. */
+static inline void knc_vpu_restore(const void *area)
+{
+	asm volatile(
+		".byte 0x62,0xf1,0x78,0x08,0x28,0x80,0x00,0x00,0x00,0x00\n\t" /* vmovaps zmm0, [rax+0] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0x88,0x40,0x00,0x00,0x00\n\t" /* vmovaps zmm1, [rax+64] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0x90,0x80,0x00,0x00,0x00\n\t" /* vmovaps zmm2, [rax+128] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0x98,0xc0,0x00,0x00,0x00\n\t" /* vmovaps zmm3, [rax+192] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0xa0,0x00,0x01,0x00,0x00\n\t" /* vmovaps zmm4, [rax+256] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0xa8,0x40,0x01,0x00,0x00\n\t" /* vmovaps zmm5, [rax+320] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0xb0,0x80,0x01,0x00,0x00\n\t" /* vmovaps zmm6, [rax+384] */
+		".byte 0x62,0xf1,0x78,0x08,0x28,0xb8,0xc0,0x01,0x00,0x00\n\t" /* vmovaps zmm7, [rax+448] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0x80,0x00,0x02,0x00,0x00\n\t" /* vmovaps zmm8, [rax+512] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0x88,0x40,0x02,0x00,0x00\n\t" /* vmovaps zmm9, [rax+576] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0x90,0x80,0x02,0x00,0x00\n\t" /* vmovaps zmm10, [rax+640] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0x98,0xc0,0x02,0x00,0x00\n\t" /* vmovaps zmm11, [rax+704] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0xa0,0x00,0x03,0x00,0x00\n\t" /* vmovaps zmm12, [rax+768] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0xa8,0x40,0x03,0x00,0x00\n\t" /* vmovaps zmm13, [rax+832] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0xb0,0x80,0x03,0x00,0x00\n\t" /* vmovaps zmm14, [rax+896] */
+		".byte 0x62,0x71,0x78,0x08,0x28,0xb8,0xc0,0x03,0x00,0x00\n\t" /* vmovaps zmm15, [rax+960] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0x80,0x00,0x04,0x00,0x00\n\t" /* vmovaps zmm16, [rax+1024] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0x88,0x40,0x04,0x00,0x00\n\t" /* vmovaps zmm17, [rax+1088] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0x90,0x80,0x04,0x00,0x00\n\t" /* vmovaps zmm18, [rax+1152] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0x98,0xc0,0x04,0x00,0x00\n\t" /* vmovaps zmm19, [rax+1216] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0xa0,0x00,0x05,0x00,0x00\n\t" /* vmovaps zmm20, [rax+1280] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0xa8,0x40,0x05,0x00,0x00\n\t" /* vmovaps zmm21, [rax+1344] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0xb0,0x80,0x05,0x00,0x00\n\t" /* vmovaps zmm22, [rax+1408] */
+		".byte 0x62,0xe1,0x78,0x08,0x28,0xb8,0xc0,0x05,0x00,0x00\n\t" /* vmovaps zmm23, [rax+1472] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0x80,0x00,0x06,0x00,0x00\n\t" /* vmovaps zmm24, [rax+1536] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0x88,0x40,0x06,0x00,0x00\n\t" /* vmovaps zmm25, [rax+1600] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0x90,0x80,0x06,0x00,0x00\n\t" /* vmovaps zmm26, [rax+1664] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0x98,0xc0,0x06,0x00,0x00\n\t" /* vmovaps zmm27, [rax+1728] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0xa0,0x00,0x07,0x00,0x00\n\t" /* vmovaps zmm28, [rax+1792] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0xa8,0x40,0x07,0x00,0x00\n\t" /* vmovaps zmm29, [rax+1856] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0xb0,0x80,0x07,0x00,0x00\n\t" /* vmovaps zmm30, [rax+1920] */
+		".byte 0x62,0x61,0x78,0x08,0x28,0xb8,0xc0,0x07,0x00,0x00\n\t" /* vmovaps zmm31, [rax+1984] */
+		"movzwl 2048(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xc1\n\t" /* kmov k0, ecx */
+		"movzwl 2050(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xc9\n\t" /* kmov k1, ecx */
+		"movzwl 2052(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xd1\n\t" /* kmov k2, ecx */
+		"movzwl 2054(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xd9\n\t" /* kmov k3, ecx */
+		"movzwl 2056(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xe1\n\t" /* kmov k4, ecx */
+		"movzwl 2058(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xe9\n\t" /* kmov k5, ecx */
+		"movzwl 2060(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xf1\n\t" /* kmov k6, ecx */
+		"movzwl 2062(%%rax), %%ecx\n\t"
+		".byte 0xc5,0xf8,0x92,0xf9\n\t" /* kmov k7, ecx */
+		: : "a" (area) : "rcx", "memory");
+}
+
+#endif /* __ASSEMBLY__ */
+#endif /* _ASM_X86_KNC_VPU_H */
diff --git a/arch/x86/kernel/fpu/core.c b/arch/x86/kernel/fpu/core.c
index 30435ae0f..b902881aa 100644
--- a/arch/x86/kernel/fpu/core.c
+++ b/arch/x86/kernel/fpu/core.c
@@ -7,6 +7,7 @@
  *	Gareth Hughes <gareth@valinux.com>, May 2000
  */
 #include <asm/fpu/api.h>
+#include <asm/knc_vpu.h>
 #include <asm/fpu/regset.h>
 #include <asm/fpu/sched.h>
 #include <asm/fpu/signal.h>
@@ -148,6 +149,9 @@ void save_fpregs_to_fpstate(struct fpu *fpu)
 
 	if (likely(use_fxsr())) {
 		fxsave(&fpu->fpstate->regs.fxsave);
+		/* Knights Corner: FXSAVE leaves the vector unit out (327364-001, B.5). */
+		if (IS_ENABLED(CONFIG_X86_KNC))
+			knc_vpu_save((void *)&fpu->fpstate->regs + KNC_VPU_STATE_OFFSET);
 		return;
 	}
 
@@ -206,10 +210,17 @@ void restore_fpregs_from_fpstate(struct fpstate *fpstate, u64 mask)
 
 		os_xrstor(fpstate, mask);
 	} else {
-		if (use_fxsr())
+		if (use_fxsr()) {
 			fxrstor(&fpstate->regs.fxsave);
-		else
+			/*
+			 * Knights Corner: FXRSTOR clears bits 0:127 of every zmm
+			 * (327364-001, B.4), so the vector unit is restored after it.
+			 */
+			if (IS_ENABLED(CONFIG_X86_KNC))
+				knc_vpu_restore((const void *)&fpstate->regs + KNC_VPU_STATE_OFFSET);
+		} else {
 			frstor(&fpstate->regs.fsave);
+		}
 	}
 }
 
diff --git a/arch/x86/kernel/fpu/init.c b/arch/x86/kernel/fpu/init.c
index a82825467..cd76b03ce 100644
--- a/arch/x86/kernel/fpu/init.c
+++ b/arch/x86/kernel/fpu/init.c
@@ -3,6 +3,7 @@
  * x86 FPU boot time init code:
  */
 #include <asm/fpu/api.h>
+#include <asm/knc_vpu.h>
 #include <asm/tlbflush.h>
 #include <asm/setup.h>
 
@@ -248,5 +249,18 @@ void __init fpu__init_system(void)
 	fpu__init_system_generic();
 	fpu__init_system_xstate_size_legacy();
 	fpu__init_system_xstate(fpu_kernel_cfg.max_size);
+
+	/*
+	 * Knights Corner: the vector unit state lives after the FXSAVE image in
+	 * every task's fpstate (asm/knc_vpu.h). The user ABI (signal frames,
+	 * ptrace) keeps the 512-byte FXSAVE image and never sees the zmm state.
+	 */
+	if (IS_ENABLED(CONFIG_X86_KNC)) {
+		fpu_kernel_cfg.max_size = KNC_FPSTATE_SIZE;
+		fpu_kernel_cfg.default_size = KNC_FPSTATE_SIZE;
+		init_fpstate.size = KNC_FPSTATE_SIZE;
+		pr_info("x86/fpu: KNC: vector unit state (%u bytes) saved with the FPU state\n",
+			KNC_VPU_STATE_SIZE);
+	}
 	fpu__init_task_struct_size();
 }
